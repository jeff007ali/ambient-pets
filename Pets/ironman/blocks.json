{
  "enter": [
    {
      "clip": "fall",
      "duration": 1.2,
      "motion": {
        "type": "enter",
        "from": "top_offscreen",
        "to": "anchor",
        "offset": [
          0,
          40
        ],
        "curve": "easeOut"
      }
    },
    {
      "clip": "land",
      "duration": 0.6,
      "motion": {
        "type": "drop"
      },
      "effects": [
        "dust_puff",
        "squash"
      ],
      "sound": "thud"
    }
  ],
  "exit": [
    {
      "clip": "rise",
      "duration": 1.3,
      "motion": {
        "type": "exit",
        "to": "top_offscreen",
        "curve": "easeIn"
      }
    }
  ],
  "blocks": {
    "hover_look": {
      "description": "hovers and looks around",
      "steps": [
        {
          "clip": "idle",
          "duration": 1.4,
          "motion": {
            "type": "hover",
            "amplitude": 3
          }
        }
      ]
    },
    "repulsor_shot": {
      "description": "fires a repulsor bolt toward the screen centre",
      "steps": [
        {
          "clip": "shoot",
          "duration": 0.9,
          "facing": "toward_center",
          "sound": "zap",
          "effects": [
            {
              "type": "projectile",
              "clip": "bolt",
              "hit": "bolt_hit",
              "at": "hand",
              "speed": 600,
              "distance": 240,
              "delay": 0.3
            }
          ]
        }
      ]
    },
    "charged_blast": {
      "description": "charges up and fires a big energy orb",
      "steps": [
        {
          "clip": "charge_start",
          "duration": 0.25,
          "facing": "toward_center"
        },
        {
          "clip": "charge",
          "duration": 0.8
        },
        {
          "clip": "charge_fire",
          "duration": 0.9,
          "sound": "zap",
          "effects": [
            {
              "type": "projectile",
              "clip": "orb",
              "hit": "orb_end",
              "at": "hand",
              "speed": 460,
              "distance": 260,
              "delay": 0.1
            }
          ]
        }
      ]
    },
    "glide_stroll": {
      "description": "glides a short way along the ground",
      "steps": [
        {
          "clip": "glide",
          "duration": 1.8,
          "motion": {
            "type": "walk",
            "speed": 55,
            "direction": "random"
          }
        }
      ]
    },
    "jab_combo": {
      "description": "throws a quick jab and punch",
      "steps": [
        {
          "clip": "jab",
          "duration": 0.6,
          "facing": "toward_center"
        },
        {
          "clip": "punch",
          "duration": 0.65
        }
      ]
    },
    "uppercut": {
      "description": "a big rising uppercut",
      "steps": [
        {
          "clip": "uppercut",
          "duration": 1.0
        }
      ]
    },
    "finisher": {
      "description": "a flashy combo finisher with a palm blast",
      "steps": [
        {
          "clip": "finisher",
          "duration": 1.1,
          "facing": "toward_center",
          "sound": "zap"
        }
      ]
    },
    "ground_pound": {
      "description": "hops up and slams the ground with a shockwave",
      "steps": [
        {
          "clip": "dive_start",
          "duration": 0.3,
          "motion": {
            "type": "hop",
            "height": 30
          }
        },
        {
          "clip": "slam",
          "duration": 0.9,
          "sound": "boom",
          "effects": [
            "squash",
            {
              "type": "overlay",
              "clip": "shockwave",
              "at": "feet",
              "hold": false
            }
          ]
        }
      ]
    },
    "celebrate": {
      "description": "a happy little boost into the air",
      "steps": [
        {
          "clip": "rise",
          "duration": 0.8,
          "motion": {
            "type": "hop",
            "height": 34
          }
        }
      ]
    },
    "hud_scan": {
      "description": "scans the area with his HUD",
      "steps": [
        {
          "clip": "idle",
          "duration": 1.8,
          "sound": "blip",
          "effects": [
            "scanline"
          ]
        }
      ]
    }
  }
}